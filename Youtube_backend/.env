PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/streamtube
MONGO_DB=streamtube
JWT_SECRET=streamtube-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_DAYS=7
BCRYPT_ROUNDS=12
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Security / OTP
TRUSTED_DEVICE_DAYS=30
OTP_SECRET=streamtube-dev-otp-secret-change-me
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
EXPOSE_DEV_OTP=true

# Comments / translation
COMMENT_EDIT_WINDOW_MINUTES=15
MAX_COMMENT_LENGTH=2000
MAX_REPORT_DETAILS=500

# Email / SMS delivery (leave blank for dev OTP code log mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=YouTube <no-reply@streamtube.local>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Demo geo trust
DEMO_PUBLIC_IP=
DEMO_CITY=
DEMO_STATE=
DEMO_COUNTRY=
